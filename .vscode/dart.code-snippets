	"Add mappers": {
		"scope": "dart",
		"prefix": "mappers",
		"include": ["**/*.dart"],
		"description": "Adds static mapper functions to class.",
		"body": [
			"/// Parses [$0] instance from a given value.",
			"///",
			"/// Value can be one of the following:",
			"/// * [Map] - then object will be parsed into [$0] object.",
			"/// * [$0] - then value will be returned as-is.",
			"static $0 Function(dynamic value) get parse =>",
			"\tMapperContainer.globals.initialized.fromValue<$0>;",
			"",
			"/// Parses [List] of [$0] instances from a given value.",
			"///",
			"/// Value can be one of the following:",
			"/// * [Iterable] of [dynamic] - then each object will be decoded same way as",
			"///   [parse] and resulting [Iterable] will be returned.",
			"/// * [Iterable] of [$0] - then value will be returned as-is.",
			"static List<$0> Function(dynamic value) get parseList =>",
			"\tMapperContainer.globals.initialized.fromValue<List<$0>>;",
			"",
			"/// Parses JSON string into [$0] similarly to [parse].",
			"static $0 Function(String json) get parseJson =>",
			"\tMapperContainer.globals.initialized.fromJson<$0>;",
			"",
			"/// Parses JSON string into [List] of [$0] instances similarly to",
			"/// [parseList].",
			"static List<$0> Function(String json) get parseJsonList =>",
			"\tMapperContainer.globals.initialized.fromJson<List<$0>>;",
		],
	}
}